---
import Base from '../layouts/Base.astro';
import Install from '../components/Install.astro';
import GittyMock from '../components/GittyMock';
import '../styles/mock.css';

const title = 'gitty — a fast terminal git client in Rust';
const description =
  'gitty is a fast terminal (TUI) git client with the GitHub Desktop experience: History, Changes, line staging, fetch, pull, push, search and compare. Written in Rust.';

const lead = {
  title: 'Stage a single line.',
  body: 'Status that follows the file system. Stage by file, hunk or line, discard with a copy kept in the Trash, and commit with amend and undo. It works on the real git index, so git status always agrees with what you see.',
  href: '/docs/using-gitty/',
  go: 'How staging works',
};

const features = [
  {
    title: 'History that keeps up',
    body: 'Local and remote commits with refs and ahead/behind marks, read straight from the commit-graph. Select a commit, or a range, for its files and a syntax-highlighted diff.',
    href: '/docs/using-gitty/',
  },
  {
    title: 'Fetch, pull, push',
    body: 'Live progress, cancel, and password prompts inside the app. A background fetch runs every few minutes so the view is never stale.',
    href: '/docs/using-gitty/',
  },
  {
    title: 'Search and compare',
    body: 'Search the whole history by text, author or path while you keep working. Compare HEAD against any branch.',
    href: '/docs/keys/',
  },
  {
    title: 'Your git, untouched',
    body: 'gitty shells out to git for everything that writes, so hooks, signing, credential helpers and your config work as they do on the command line.',
    href: '/docs/configuration/',
  },
  {
    title: 'Fast on real repos',
    body: '14 ms to first frame and a 220×60 redraw in 0.5 ms, measured on git/git and a Linux kernel clone. CI enforces the budgets.',
    href: '/docs/installation/',
  },
];

const origin = String(new URL('/', Astro.site));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${origin}#website`, name: 'gitty', url: origin, inLanguage: 'en' },
    {
      '@type': 'SoftwareApplication',
      '@id': `${origin}#app`,
      name: 'gitty',
      alternateName: 'gitty terminal git client',
      description,
      url: origin,
      image: String(new URL('/og.png', Astro.site)),
      operatingSystem: 'macOS, Linux',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Git client',
      softwareRequirements: 'git 2.30 or newer',
      programmingLanguage: 'Rust',
      downloadUrl: 'https://github.com/VedangP57/gitty/releases',
      installUrl: String(new URL('/docs/installation/', Astro.site)),
      license: 'https://github.com/VedangP57/gitty/blob/main/LICENSE',
      isAccessibleForFree: true,
      featureList: [
        'History with refs and ahead/behind marks',
        'Stage by file, hunk or single line',
        'Fetch, pull and push with live progress',
        'Search and compare across the full history',
        'Eleven built-in themes, switched live',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      softwareVersion: '0.1.2',
      sameAs: ['https://github.com/VedangP57/gitty'],
      isPartOf: { '@id': `${origin}#website` },
    },
  ],
};
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hd-hero">
    <div class="shell">
      <h1>Your repo, live.<br />Leave it open.</h1>
      <div class="hero-side">
        <p class="lede">
          A fast git TUI with the GitHub Desktop experience. History, line staging, fetch, push and
          search, written in Rust.
        </p>
        <Install cmd="brew install vedangp57/tap/gitty" />
        <div class="hero-meta">Runs on macOS and Linux with git 2.30 or newer.</div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/installation/">Read the docs</a>
          <a class="btn" href="https://github.com/VedangP57/gitty/releases">Releases</a>
        </div>
      </div>
    </div>
  </section>

  <section class="proof" aria-label="highlights">
    <div class="shell proof-grid">
      <p><b>14 ms</b> to first frame on git/git</p>
      <p><b>1.48M</b> commits walked in a kernel clone</p>
      <p><b>11</b> built-in themes, switched live</p>
      <p><b>MIT</b> licensed, no telemetry</p>
    </div>
  </section>

  <section class="fig fig--demo">
    <div class="shell">
      <div class="fighd">
        <h2>Click it. It behaves like gitty.</h2>
      </div>
      <GittyMock client:visible />
    </div>
  </section>

  <section class="fig">
    <div class="shell">
      <div class="fighd fighd--quiet">
        <h2>What else it does</h2>
      </div>
      <article class="lead">
        <h3>{lead.title}</h3>
        <div>
          <p>{lead.body}</p>
          <a class="go" href={lead.href}>{lead.go}</a>
        </div>
      </article>
      <div class="sheets">
        {
          features.map((f) => (
            <article class="sheet">
              <h3>
                <a href={f.href}>{f.title}</a>
              </h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="shell">
      <h2>Give your repo somewhere to live.</h2>
      <p>One command. Your git config, hooks and credential helpers keep working as they are.</p>
      <Install cmd="brew install vedangp57/tap/gitty" />
    </div>
  </section>
</Base>
